{
  "manifest_version": 3,
  "name": "공문 도우미",
  "version": "1.3.0",
  "description": "데이터취합 제출기관 자동추가 · 장바구니 품의(쇼핑몰 장바구니 → K-에듀파인 품목내역) · 업무포털 자동 로그인. 제작 강주원",
  "author": "평택교육지원청 장학사 강주원",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.edmgr.kr/*",
    "https://goe.eduptl.kr/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.edmgr.kr/*"
      ],
      "js": [
        "regions.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://goe.eduptl.kr/*"
      ],
      "js": [
        "portal.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "공문 도우미 — 장바구니 품의 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
